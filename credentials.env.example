# Platform-scoped credentials are configured explicitly, reused by future
# Blueprints, and not deleted with a Blueprint. Copy this file outside the
# repository with mode 600; never pass these values as command arguments.

# Required whenever a component uses chartRepo: application-collection,
# including AIFLab demo storage and Kubeflow.
AIF_APPLICATION_COLLECTION_USERNAME=
AIF_APPLICATION_COLLECTION_TOKEN=

# Optional; required only for protected SUSE Registry content.
# AIF_SUSE_REGISTRY_USERNAME=
# AIF_SUSE_REGISTRY_TOKEN=

# Optional; required for protected NVIDIA charts, images, or APIs.
# AIF_NVIDIA_USERNAME defaults to $oauthtoken.
# AIF_NVIDIA_API_KEY=
# AIF_NVIDIA_USERNAME=
